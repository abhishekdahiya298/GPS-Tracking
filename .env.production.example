# Production environment template for a Linux VPS deployment.
# Copy to .env on the VPS, fill in real values, and set file permissions to
# 600 (chmod 600 .env) so only the deploying user can read it. NEVER commit
# the real .env — it is gitignored. Generate every "change_me" value fresh
# per environment (openssl rand -hex 16 / openssl rand -base64 32); never
# reuse a development secret in production.

# --- Postgres container bootstrap (infra/postgres/init-databases.sh) ---
POSTGRES_SUPERUSER_PASSWORD=change_me
RIO_DB_PASSWORD=change_me
TRACCAR_DB_PASSWORD=change_me

# Loopback-only host ports (see infra/docker-compose.yml) — a fresh VPS has
# no port conflicts, so the defaults are almost always correct.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- RIO application database (separate from Traccar's DB) ---
# In production, web/worker always run inside docker-compose, so this value
# is only used as the env_file default; docker-compose.yml's own
# `environment:` block overrides it to the internal postgres:5432 hostname
# for the actual containers. Keep it consistent for any one-off host-side
# tooling (e.g. `docker compose exec web pnpm db:migrate` runs inside the
# container, so it uses the override automatically).
RIO_DATABASE_URL=postgres://rio:change_me@localhost:5432/rio
TRACCAR_DATABASE_URL=postgres://traccar:change_me@localhost:5432/traccar

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Traccar integration ---
# Internal REST API URL as reached from other containers, not the public
# admin port (which is loopback-only — see infra/docker-compose.yml).
TRACCAR_API_URL=http://traccar:8082
TRACCAR_API_USER=admin@rio-gps.local
TRACCAR_API_PASSWORD=change_me

# Shared secret Traccar must present when calling RIO's webhook ingest endpoint.
TRACCAR_WEBHOOK_SECRET=change_me_to_a_long_random_value

# --- Auth ---
AUTH_SECRET=change_me_to_a_long_random_value
AUTH_URL=https://your-domain.example

# --- Reverse proxy (infra/Caddyfile) ---
# Real public domain. Caddy requests a Let's Encrypt certificate for this
# automatically — DNS must already point at the VPS's public IP before
# starting the stack, or cert issuance will fail.
RIO_DOMAIN=your-domain.example

# --- App ---
NODE_ENV=production
WEB_PORT=3000
WORKER_PORT=3100

# Email via Resend (optional)
RESEND_API_KEY=
EMAIL_FROM=RIO GPS <no-reply@riocaliforniainc.com>
