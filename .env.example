# --- Postgres container bootstrap (infra/postgres/init-databases.sh) ---
# Superuser password for the postgres container itself.
POSTGRES_SUPERUSER_PASSWORD=change_me
# Password for the rio/traccar app users created on first container start.
# Must match the password embedded in RIO_DATABASE_URL / TRACCAR_DATABASE_URL below.
RIO_DB_PASSWORD=change_me
TRACCAR_DB_PASSWORD=change_me

# Host-side port Postgres/Redis are published on (loopback only — see
# infra/docker-compose.yml). Default 5432/6379 is correct on a fresh Linux
# VPS. On a dev machine that already runs a native Postgres on 5432, set
# POSTGRES_HOST_PORT=55432 (or similar) instead — and update the *_DATABASE_URL
# port below to match.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# --- RIO application database (separate from Traccar's DB) ---
# These localhost URLs are for tooling run ON THE HOST (pnpm db:migrate, pnpm
# dev:web). Containerized web/worker services override this to the internal
# postgres:5432 hostname — see infra/docker-compose.yml.
RIO_DATABASE_URL=postgres://rio:change_me@localhost:5432/rio

# --- Traccar's own database (RIO never queries this directly) ---
TRACCAR_DATABASE_URL=postgres://traccar:change_me@localhost:5432/traccar

# --- Redis (pub/sub for live location updates) ---
REDIS_URL=redis://localhost:6379

# --- Traccar integration ---
# Base URL of Traccar's REST API, used only for admin/lookup calls, never for live data path in v0.
TRACCAR_API_URL=http://localhost:8082
TRACCAR_API_USER=admin@rio-gps.local
TRACCAR_API_PASSWORD=change_me

# Shared secret Traccar (or a forwarding shim) must present when calling RIO's webhook ingest endpoint.
# Sent as: Authorization: Bearer <TRACCAR_WEBHOOK_SECRET>
TRACCAR_WEBHOOK_SECRET=change_me_to_a_long_random_value

# --- Auth ---
# Symmetric key used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=change_me_to_a_long_random_value
AUTH_URL=http://localhost:3000

# --- Reverse proxy (infra/Caddyfile) ---
# Public domain Caddy requests a TLS cert for. Not used in local dev
# (AUTH_URL/browser access stays on localhost:3000 directly).
RIO_DOMAIN=localhost

# --- App ---
NODE_ENV=development
WEB_PORT=3000
WORKER_PORT=3100

# Email (optional). Without it, admins hand out one-time temporary passwords.
RESEND_API_KEY=
EMAIL_FROM=RIO GPS <no-reply@riocaliforniainc.com>
